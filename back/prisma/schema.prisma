// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Members ───────────────────────────────────────────────────────────

model Member {
  id            Int       @id @default(autoincrement())
  email         String?   @unique
  password      String?
  login         String?   @unique
  nickname      String?
  internal_note String?
  join_date     DateTime?
  updated_at    DateTime? @updatedAt
  created_at    DateTime? @default(now())

  adhesions               Adhesion[]
  member_roles            MemberRole[]
  shifts_managed          Shift[]              @relation("ShiftManager")
  shift_members           ShiftMember[]
  shift_assignments       ShiftAssignment[]
  vehicles                Vehicle[]
  expense_trips           ExpenseTrip[]
  member_battlepass_rewards MemberBattlepassReward[]
  sessions                Session[]

  @@map("members")
}

model Session {
  id            Int      @id @default(autoincrement())
  member_id     Int
  refresh_token String
  user_agent    String?
  ip_address    String?
  created_at    DateTime
  expires_at    DateTime

  member Member @relation(fields: [member_id], references: [id])

  @@map("sessions")
}

model Adhesion {
  id         Int       @id @default(autoincrement())
  year       Int
  member_id  Int
  created_at DateTime? @default(now())

  member Member @relation(fields: [member_id], references: [id])

  @@map("adhesion")
}

// ─── Roles & Permissions ──────────────────────────────────────────────────────

model Role {
  id   Int    @id @default(autoincrement())
  role String @unique

  role_permissions RolePermission[]
  member_roles     MemberRole[]

  @@map("roles")
}

model Permission {
  id     Int    @id @default(autoincrement())
  label  String
  parent Int?

  parent_permission    Permission?  @relation("PermissionParent", fields: [parent], references: [id])
  child_permissions    Permission[] @relation("PermissionParent")
  role_permissions     RolePermission[]

  @@map("permission")
}

model RolePermission {
  id         Int @id @default(autoincrement())
  role       Int
  permission Int

  role_ref       Role       @relation(fields: [role], references: [id])
  permission_ref Permission @relation(fields: [permission], references: [id])

  @@map("role_permissions")
}

model MemberRole {
  id     Int  @id @default(autoincrement())
  member Int?
  role   Int?

  member_ref Member? @relation(fields: [member], references: [id])
  role_ref   Role?   @relation(fields: [role], references: [id])

  @@map("member_roles")
}

// ─── Shifts ───────────────────────────────────────────────────────────────────

model Shift {
  id                 Int      @id @default(autoincrement())
  date               DateTime
  manager            Int
  discord_message_id String
  validated          Boolean

  manager_ref  Member        @relation("ShiftManager", fields: [manager], references: [id])
  shift_members ShiftMember[]

  @@map("shifts")
}

model ShiftMember {
  id          Int  @id @default(autoincrement())
  shift_id    Int
  member_id   Int
  position_id Int?

  shift    Shift          @relation(fields: [shift_id], references: [id])
  member   Member         @relation(fields: [member_id], references: [id])
  position ShiftPosition? @relation(fields: [position_id], references: [id])

  @@map("shift_members")
}

model ShiftPosition {
  id       Int     @id @default(autoincrement())
  position String  @unique
  xp_mult  Float?  @default(1)

  shift_members ShiftMember[]

  @@map("shift_positions")
}

model ShiftAssignment {
  id        Int       @id @default(autoincrement())
  date      DateTime?
  member_id Int?

  member Member? @relation(fields: [member_id], references: [id])

  @@map("shift_assignment")
}

// ─── Stock ────────────────────────────────────────────────────────────────────

model StockCategory {
  id          Int     @id @default(autoincrement())
  name        String?
  order_index Int?

  stock_items StockItem[]

  @@map("stock_category")
}

model StockItem {
  id                Int     @id @default(autoincrement())
  name              String?
  category_id       Int?
  expected_quantity Int?
  missing_quantity  Int?
  unit              String?
  is_active         Boolean?

  category StockCategory? @relation(fields: [category_id], references: [id])

  @@map("stock_item")
}

// ─── VVehicles & Mileage Expenses ──────────────────────────────────────────────

model Vehicle {
  id                   Int       @id @default(autoincrement())
  member_id            Int
  registration_doc_url String?
  fiscal_power         Int
  is_active            Boolean   @default(true)
  created_at           DateTime?

  member        Member        @relation(fields: [member_id], references: [id])
  expense_trips ExpenseTrip[]

  @@map("vehicle")
}

model ExpenseTrip {
  id          Int       @id @default(autoincrement())
  member_id   Int
  vehicle_id  Int
  trip_date   DateTime
  distance_km Int
  purpose     String?
  is_paid     Boolean   @default(false)
  paid_at     DateTime?
  created_at  DateTime?

  member  Member  @relation(fields: [member_id], references: [id])
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])

  @@map("expense_trip")
}

// ─── Battlepass ───────────────────────────────────────────────────────────────

model BattlepassSeason {
  id       Int      @id @default(autoincrement())
  name     String
  start_at DateTime
  end_at   DateTime

  tiers   BattlepassTier[]
  rewards MemberBattlepassReward[]

  @@map("battlepass_seasons")
}

model BattlepassTier {
  id          Int    @id @default(autoincrement())
  season_id   Int
  tier_number Int
  requirement Int
  reward      String

  season  BattlepassSeason         @relation(fields: [season_id], references: [id])
  rewards MemberBattlepassReward[]

  @@map("battlepass_tiers")
}

model MemberBattlepassReward {
  id         Int      @id @default(autoincrement())
  member_id  Int
  season_id  Int
  tier_id    Int
  claimed_at DateTime

  member Member           @relation(fields: [member_id], references: [id])
  season BattlepassSeason @relation(fields: [season_id], references: [id])
  tier   BattlepassTier   @relation(fields: [tier_id], references: [id])

  @@map("member_battlepass_rewards")
}
